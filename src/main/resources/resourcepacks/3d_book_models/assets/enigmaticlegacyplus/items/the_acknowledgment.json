    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": [
          "gui"
        ],
        "model": {
          "type": "minecraft:model",
          "model": "enigmaticlegacyplus:item/gui/the_acknowledgment"
        }
      },
      {
        "when": [
          "fixed",
