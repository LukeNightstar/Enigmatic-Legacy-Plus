        ],
        "model": {
          "type": "minecraft:model",
          "model": "enigmaticlegacyplus:item/3d/the_acknowledgment"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "enigmaticlegacyplus:item/3d/the_acknowledgment"
    }
  }
}
